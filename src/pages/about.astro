---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About';
const description = 'A little about me.';
---

<BaseLayout title={title} description={description}>
  <h1>About</h1>
  <p>
    I'm Travis, and this is where I write about the projects I'm working on,
    things I'm learning, and whatever else is on my mind.
  </p>
  <p>
    This site is built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
    and published with GitHub Pages.
  </p>
</BaseLayout>
